/T (// middleware/auth.js const { verifyToken } = require\('../utils/token'\); const User = require\('../models/user'\); module.exports = async function auth\(req, res, next\) {   try {     const h = req.header\('authorization'\);     if \(!h?.startsWith\('Bearer '\)\) return res.status\(401\).json\({ error: 'Missing token' }\);     const token = h.split\(' '\)[1];     let payload;     try { payload = verifyToken\(token\); } catch { return res.status\(403\).json\({ error: 'Invalid or expired token' }\); }     const user = await User.findById\(payload.sub\).select\('role tokenVersion'\).lean\(\);     if \(!user\) return res.status\(401\).json\({ error: 'User not found' }\);     if \(user.tokenVersion !== payload.tv\) return res.status\(403\).json\({ error: 'Token revoked' }\);     req.user = { id: payload.sub, role: payload.role }; next\(\);   } catch \(e\) { console.error\('auth err', e\); res.status\(500\).json\({ error: 'Auth error' }\); } }; // middleware/rbac.js module.exports = function rbac\(requiredPerm\) {   return \(req, res, next\) => {     try {       const policy = req.app.locals.rbacPolicy || {};       const role = req.user?.role; if \(!role\) return res.status\(401\).json\({ error: 'No role' }\);       const perms = policy[role] || [];       const ok = perms.some\(p => p === requiredPerm || \(p.endsWith\('*'\) && requiredPerm.startsWith\(p.slice\(0, -1\)\)\)\);       if \(!ok\) return res.status\(403\).json\({ error: 'Insufficient Permissions' }\);       next\(\);     } catch \(e\) { console.error\('rbac err', e\); res.status\(500\).json\({ error: 'Authorization error' }\); }   }; }; // routes/profile.js const express = require\('express'\); const router = express.Router\(\); const auth = require\('../middleware/auth'\); const rbac = require\('../middleware/rbac'\); const User = require\('../models/user'\); router.delete\('/:id', auth, rbac\('profile:deleteAny'\), async \(req, res\) => {   try {     const deleted = await User.findByIdAndDelete\(req.params.id\);     if \(!deleted\) return res.status\(404\).json\({ error: 'Profile not found' }\);     // TODO: add audit log     res.json\({ ok: true, msg: 'Profile deleted' }\);   } catch \(e\) { console.error\('delete profile err', e\); res.status\(500\).json\({ error: 'Could not delete profile' }\); } }\); module.exports = router; // policy.json {   "admin": ["user:manage","profile:*","account:*","transaction:*","reports:view"],   "manager": ["account:create","account:read","transaction:read","reports:view","profile:read"],   "customer": ["account:read","transaction:create","transaction:read","profile:read","profile:deleteOwn"] })
/E (// middleware/auth.js const { verifyToken } = require\('../utils/token'\); const User = require\('../models/user'\); module.exports = async function auth\(req, res, next\) {   try {     const h = req.header\('authorization'\);     if \(!h?.startsWith\('Bearer '\)\) return res.status\(401\).json\({ error: 'Missing token' }\);     const token = h.split\(' '\)[1];     let payload;     try { payload = verifyToken\(token\); } catch { return res.status\(403\).json\({ error: 'Invalid or expired token' }\); }     const user = await User.findById\(payload.sub\).select\('role tokenVersion'\).lean\(\);     if \(!user\) return res.status\(401\).json\({ error: 'User not found' }\);     if \(user.tokenVersion !== payload.tv\) return res.status\(403\).json\({ error: 'Token revoked' }\);     req.user = { id: payload.sub, role: payload.role }; next\(\);   } catch \(e\) { console.error\('auth err', e\); res.status\(500\).json\({ error: 'Auth error' }\); } }; // middleware/rbac.js module.exports = function rbac\(requiredPerm\) {   return \(req, res, next\) => {     try {       const policy = req.app.locals.rbacPolicy || {};       const role = req.user?.role; if \(!role\) return res.status\(401\).json\({ error: 'No role' }\);       const perms = policy[role] || [];       const ok = perms.some\(p => p === requiredPerm || \(p.endsWith\('*'\) && requiredPerm.startsWith\(p.slice\(0, -1\)\)\)\);       if \(!ok\) return res.status\(403\).json\({ error: 'Insufficient Permissions' }\);       next\(\);     } catch \(e\) { console.error\('rbac err', e\); res.status\(500\).json\({ error: 'Authorization error' }\); }   }; }; // routes/profile.js const express = require\('express'\); const router = express.Router\(\); const auth = require\('../middleware/auth'\); const rbac = require\('../middleware/rbac'\); const User = require\('../models/user'\); router.delete\('/:id', auth, rbac\('profile:deleteAny'\), async \(req, res\) => {   try {     const deleted = await User.findByIdAndDelete\(req.params.id\);     if \(!deleted\) return res.status\(404\).json\({ error: 'Profile not found' }\);     // TODO: add audit log     res.json\({ ok: true, msg: 'Profile deleted' }\);   } catch \(e\) { console.error\('delete profile err', e\); res.status\(500\).json\({ error: 'Could not delete profile' }\); } }\); module.exports = router; // policy.json {   "admin": ["user:manage","profile:*","account:*","transaction:*","reports:view"],   "manager": ["account:create","account:read","transaction:read","reports:view","profile:read"],   "customer": ["account:read","transaction:create","transaction:read","profile:read","profile:deleteOwn"] })
